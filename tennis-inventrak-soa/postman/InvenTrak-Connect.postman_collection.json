            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"ServicioDevoluciones\",\n  \"descripcion\": \"Reingresa al inventario las unidades devueltas por clientes.\",\n  \"responsable\": \"InvenTrak\",\n  \"version\": \"0.1.0\",\n  \"estado\": \"EN_DISENO\",\n  \"operaciones\": [\n    \"POST /api/v1/devoluciones\"\n  ],\n  \"ubicacion\": \"/api/v1/devoluciones\",\n  \"consumidores\": [\n    \"POS\",\n    \"Tienda en línea\"\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 201 (o 409 si ya existía)', () => pm.expect(pm.response.code).to.be.oneOf([201, 409]));"
                ]
              }
            }
          ]
        },
